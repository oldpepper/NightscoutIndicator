<Window x:Class="NightscoutIndicator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NightscoutIndicator"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Visibility="{Binding Visibility, NotifyOnTargetUpdated=True, NotifyOnSourceUpdated=True, Mode=TwoWay}"
        Title="Nightscout Indicator Settings" Height="359" Width="665">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" MinWidth="150"></ColumnDefinition>
            <ColumnDefinition Width="*" MinWidth="200"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" ></RowDefinition>
            <RowDefinition Height="25"></RowDefinition>
            <RowDefinition Height="25"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Grid.Column="0" Content="NightscoutUrl" HorizontalAlignment="Left" VerticalAlignment="Center"  Width="78" Height="25" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NightscoutUrl}"  HorizontalAlignment="Stretch" />

        <Button Grid.Row="3" Grid.Column="0" Command="{Binding SaveCommand}" VerticalAlignment="Bottom" Margin="2" Height="18">Save</Button>

        <Button Grid.Row="3" Grid.Column="1" Command="{Binding ShowDiagramCommand}" VerticalAlignment="Bottom" Margin="2" Height="18">Save</Button>
    </Grid>
</Window>
