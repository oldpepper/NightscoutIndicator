<Window x:Class="NightscoutIndicator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NightscoutIndicator"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:SettingsViewModel}"
        Title="Nightscout Indicator Settings"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="0,4,0,8">
        <GroupBox Header="Nightscout server">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="URL" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NightscoutUrl, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="1" Grid.Column="0" Content="API secret" />
                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox Grid.Column="0" x:Name="ApiSecretBox" PasswordChanged="ApiSecretBox_OnPasswordChanged">
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ShowApiSecretButton}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>
                    <TextBox Grid.Column="0"
                             Text="{Binding ApiSecret, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsChecked, ElementName=ShowApiSecretButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ToggleButton Grid.Column="1"
                                  x:Name="ShowApiSecretButton"
                                  Width="26"
                                  Margin="2"
                                  Padding="0"
                                  FontFamily="Segoe MDL2 Assets"
                                  Content="&#xE7B3;"
                                  ToolTip="Show or hide the secret"
                                  Unchecked="ShowApiSecretButton_OnUnchecked" />
                </Grid>

                <Label Grid.Row="2" Grid.Column="0" Content="Update interval, s" />
                <TextBox Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding UpdateInterval, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="3" Grid.Column="0" Content="Data expiration timeout, min" />
                <TextBox Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding DataExpirationTimeout, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="Glucose">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Unit" />
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" />

                <Label Grid.Row="1" Grid.Column="0" Content="Thresholds" />
                <Label Grid.Row="1" Grid.Column="1" Content="Extra low" Padding="2,0" />
                <Label Grid.Row="1" Grid.Column="2" Content="Low" Padding="2,0" />
                <Label Grid.Row="1" Grid.Column="3" Content="High" Padding="2,0" />
                <Label Grid.Row="1" Grid.Column="4" Content="Extra high" Padding="2,0" />

                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ExtraLow, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Low, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding High, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Row="2" Grid.Column="4" Width="86" HorizontalAlignment="Left" Text="{Binding ExtraHigh, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="Graph">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Time range, h" />
                <TextBox Grid.Row="0" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding TimeRange, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="1" Grid.Column="0" Content="Size (width × height), px" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Width="80" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Content="×" />
                    <TextBox Width="80" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Label Grid.Row="2" Grid.Column="0" Content="Font size" />
                <TextBox Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="Alarm">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="6,4" Content="Play sound and show notification" IsChecked="{Binding UseAlarm}" />

                <Label Grid.Row="1" Grid.Column="0" Content="Repeat not more often, min" />
                <TextBox Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding AlarmInterval, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="2" Grid.Column="0" Content="High glucose alarm sound file" />
                <Grid Grid.Row="2" Grid.Column="1" DataContext="{Binding AlarmHiSound}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Style="{StaticResource SmallButtonStyle}"
                            Content="▶" Foreground="Green" ToolTip="Play sound"
                            Command="{Binding PlayCommand}" />
                    <Button Grid.Column="2" Style="{StaticResource SmallButtonStyle}"
                            Content="..." ToolTip="Select sound file"
                            Command="{Binding BrowseCommand}" />
                    <Button Grid.Column="3" Style="{StaticResource SmallButtonStyle}"
                            Content="✕" Foreground="Red" FontWeight="Bold" ToolTip="Reset to default sound"
                            Command="{Binding ResetCommand}" />
                </Grid>

                <Label Grid.Row="3" Grid.Column="0" Content="Low glucose alarm sound file" />
                <Grid Grid.Row="3" Grid.Column="1" DataContext="{Binding AlarmLowSound}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Style="{StaticResource SmallButtonStyle}"
                            Content="▶" Foreground="Green" ToolTip="Play sound"
                            Command="{Binding PlayCommand}" />
                    <Button Grid.Column="2" Style="{StaticResource SmallButtonStyle}"
                            Content="..." ToolTip="Select sound file"
                            Command="{Binding BrowseCommand}" />
                    <Button Grid.Column="3" Style="{StaticResource SmallButtonStyle}"
                            Content="✕" Foreground="Red" FontWeight="Bold" ToolTip="Reset to default sound"
                            Command="{Binding ResetCommand}" />
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Header="Flying indicator">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Size, px" />
                <TextBox Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding FlyingIndicatorSize, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="Tray icon">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Mode" />
                <ComboBox Grid.Column="1" Width="200" HorizontalAlignment="Left"
                          ItemsSource="{Binding TrayIconModes}" SelectedItem="{Binding TrayIconMode}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="Tray trend icons" IsEnabled="{Binding IsTwoIconsMode}">
            <ItemsControl ItemsSource="{Binding TrendIcons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:IconFileViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" Content="{Binding Title}" />
                            <TextBox Grid.Column="1" Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" />
                            <!-- Gray background, as the tray draws the icon over the glucose zone color -->
                            <Border Grid.Column="2" Margin="2" Width="26" Height="26" Background="DimGray"
                                    ToolTip="Icon preview">
                                <Image Width="24" Height="24" Source="{Binding Preview}" />
                            </Border>
                            <Button Grid.Column="3" Style="{StaticResource SmallButtonStyle}"
                                    Content="..." ToolTip="Select icon file"
                                    Command="{Binding BrowseCommand}" />
                            <Button Grid.Column="4" Style="{StaticResource SmallButtonStyle}"
                                    Content="✕" Foreground="Red" FontWeight="Bold" ToolTip="Reset to default icon"
                                    Command="{Binding ResetCommand}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <TextBlock Margin="12,4" TextWrapping="Wrap" Foreground="Firebrick"
                   Text="{Binding ErrorText}"
                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <StackPanel Margin="8,8,8,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" IsDefault="True" Command="{Binding SaveCommand}" />
            <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
