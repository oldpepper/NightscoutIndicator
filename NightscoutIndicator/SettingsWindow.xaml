<Window x:Class="NightscoutIndicator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NightscoutIndicator"
        xmlns:loc="clr-namespace:NightscoutIndicator.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:SettingsViewModel}"
        Title="{loc:Loc Settings.Title}"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="0,4,0,8">
        <Grid Margin="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="{loc:Loc Settings.Language}" />
            <ComboBox Grid.Column="1" Width="160" HorizontalAlignment="Left"
                      ItemsSource="{Binding Languages}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Code"
                      SelectedValue="{Binding Language}" />
        </Grid>

        <GroupBox Header="{loc:Loc Settings.Server}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="{loc:Loc Settings.Url}" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NightscoutUrl, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="1" Grid.Column="0" Content="{loc:Loc Settings.ApiSecret}" />
                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox Grid.Column="0" x:Name="ApiSecretBox" PasswordChanged="ApiSecretBox_OnPasswordChanged">
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ShowApiSecretButton}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>
                    <TextBox Grid.Column="0"
                             Text="{Binding ApiSecret, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsChecked, ElementName=ShowApiSecretButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ToggleButton Grid.Column="1"
                                  x:Name="ShowApiSecretButton"
                                  Width="26"
                                  Margin="2"
                                  Padding="0"
                                  FontFamily="Segoe MDL2 Assets"
                                  Content="&#xE7B3;"
                                  ToolTip="{loc:Loc Settings.ApiSecretToggle}"
                                  Unchecked="ShowApiSecretButton_OnUnchecked" />
                </Grid>

                <Label Grid.Row="2" Grid.Column="0" Content="{loc:Loc Settings.UpdateInterval}" />
                <TextBox Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding UpdateInterval, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="3" Grid.Column="0" Content="{loc:Loc Settings.DataExpiration}" />
                <TextBox Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding DataExpirationTimeout, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="{loc:Loc Settings.Glucose}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="{loc:Loc Settings.Unit}" />
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" />

                <Label Grid.Row="1" Grid.Column="0" Content="{loc:Loc Settings.Thresholds}" />
                <Label Grid.Row="1" Grid.Column="1" Content="{loc:Loc Settings.ExtraLow}" Padding="2,0" />
                <Label Grid.Row="1" Grid.Column="2" Content="{loc:Loc Settings.Low}" Padding="2,0" />
                <Label Grid.Row="1" Grid.Column="3" Content="{loc:Loc Settings.High}" Padding="2,0" />
                <Label Grid.Row="1" Grid.Column="4" Content="{loc:Loc Settings.ExtraHigh}" Padding="2,0" />

                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ExtraLow, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Low, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding High, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Row="2" Grid.Column="4" Width="86" HorizontalAlignment="Left" Text="{Binding ExtraHigh, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="{loc:Loc Settings.Graph}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="{loc:Loc Settings.TimeRange}" />
                <TextBox Grid.Row="0" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding TimeRange, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="1" Grid.Column="0" Content="{loc:Loc Settings.GraphSize}" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Width="80" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Content="×" />
                    <TextBox Width="80" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Label Grid.Row="2" Grid.Column="0" Content="{loc:Loc Settings.FontSize}" />
                <TextBox Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="{loc:Loc Settings.Alarm}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="6,4" Content="{loc:Loc Settings.UseAlarm}" IsChecked="{Binding UseAlarm}" />

                <Label Grid.Row="1" Grid.Column="0" Content="{loc:Loc Settings.AlarmInterval}" />
                <TextBox Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding AlarmInterval, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="2" Grid.Column="0" Content="{loc:Loc Settings.AlarmHiFile}" />
                <Grid Grid.Row="2" Grid.Column="1" DataContext="{Binding AlarmHiSound}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Style="{StaticResource SmallButtonStyle}"
                            Content="▶" Foreground="Green" ToolTip="{loc:Loc Settings.PlaySound}"
                            Command="{Binding PlayCommand}" />
                    <Button Grid.Column="2" Style="{StaticResource SmallButtonStyle}"
                            Content="..." ToolTip="{loc:Loc Settings.SelectSoundFile}"
                            Command="{Binding BrowseCommand}" />
                    <Button Grid.Column="3" Style="{StaticResource SmallButtonStyle}"
                            Content="✕" Foreground="Red" FontWeight="Bold" ToolTip="{loc:Loc Settings.ResetSound}"
                            Command="{Binding ResetCommand}" />
                </Grid>

                <Label Grid.Row="3" Grid.Column="0" Content="{loc:Loc Settings.AlarmLowFile}" />
                <Grid Grid.Row="3" Grid.Column="1" DataContext="{Binding AlarmLowSound}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Style="{StaticResource SmallButtonStyle}"
                            Content="▶" Foreground="Green" ToolTip="{loc:Loc Settings.PlaySound}"
                            Command="{Binding PlayCommand}" />
                    <Button Grid.Column="2" Style="{StaticResource SmallButtonStyle}"
                            Content="..." ToolTip="{loc:Loc Settings.SelectSoundFile}"
                            Command="{Binding BrowseCommand}" />
                    <Button Grid.Column="3" Style="{StaticResource SmallButtonStyle}"
                            Content="✕" Foreground="Red" FontWeight="Bold" ToolTip="{loc:Loc Settings.ResetSound}"
                            Command="{Binding ResetCommand}" />
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Header="{loc:Loc Settings.FlyingIndicator}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="{loc:Loc Settings.IndicatorSize}" />
                <TextBox Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding FlyingIndicatorSize, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="{loc:Loc Settings.TrayIcon}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="{loc:Loc Settings.TrayMode}" />
                <ComboBox Grid.Column="1" Width="260" HorizontalAlignment="Left"
                          ItemsSource="{Binding TrayIconModes}"
                          DisplayMemberPath="Title"
                          SelectedValuePath="Mode"
                          SelectedValue="{Binding TrayIconMode}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="{loc:Loc Settings.TrendIcons}" IsEnabled="{Binding IsTwoIconsMode}">
            <ItemsControl ItemsSource="{Binding TrendIcons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:IconFileViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" Content="{Binding Title}" />
                            <TextBox Grid.Column="1" Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" />
                            <!-- Gray background, as the tray draws the icon over the glucose zone color -->
                            <Border Grid.Column="2" Margin="2" Width="26" Height="26" Background="DimGray"
                                    ToolTip="{loc:Loc Settings.IconPreview}">
                                <Image Width="24" Height="24" Source="{Binding Preview}" />
                            </Border>
                            <Button Grid.Column="3" Style="{StaticResource SmallButtonStyle}"
                                    Content="..." ToolTip="{loc:Loc Settings.SelectIconFile}"
                                    Command="{Binding BrowseCommand}" />
                            <Button Grid.Column="4" Style="{StaticResource SmallButtonStyle}"
                                    Content="✕" Foreground="Red" FontWeight="Bold" ToolTip="{loc:Loc Settings.ResetIcon}"
                                    Command="{Binding ResetCommand}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <TextBlock Margin="12,4" TextWrapping="Wrap" Foreground="Firebrick"
                   Text="{Binding ErrorText}"
                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <StackPanel Margin="8,8,8,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Loc Common.Save}" IsDefault="True" Command="{Binding SaveCommand}" />
            <Button Content="{loc:Loc Common.Cancel}" IsCancel="True" Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
